{
  "name": "wp-block-icon-preview",
  "version": "1.0.0",
  "description": "A developer utility block for previewing and sanitizing SVG block icons.",
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=./src/blocks --blocks-manifest",
    "start": "wp-scripts start --webpack-src-dir=./src/blocks --blocks-manifest",
    "lint:js": "wp-scripts lint-js",
    "lint:style": "wp-scripts lint-style",
    "lint:php": "composer run lint",
    "format": "wp-scripts format",
    "packages-update": "wp-scripts packages-update"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "path": "^0.12.7",
    "promise-fs": "^2.1.1",
    "url": "^0.11.4"
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "svgo": "^4.0.1"
  }
}
