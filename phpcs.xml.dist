<?xml version="1.0"?>
<ruleset name="WP Block Icon Preview">
    <description>Custom PHPCS ruleset for WP Block Icon Preview</description>

    <file>wp-block-icon-preview.php</file>
    <file>src/php/</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_supported_wp_version" value="6.0"/>
    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wp-block-icon-preview"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="dlxplugins"/>
                <element value="wp_block_icon_preview"/>
                <element value="WP_BLOCK_ICON_PREVIEW"/>
            </property>
        </properties>
    </rule>
</ruleset>
